    "@mdx-js/react": "^3.1.0",
    "@mermaid-js/layout-elk": "^0.1.9",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "prop-types": "^15.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "overrides": {
    "js-yaml": "^4.3.0",
    "brace-expansion": "^5.0.8",
    "serialize-javascript": "^7.0.5",
